# Copy to .env and fill in.  `make env` generates one with a random ClickHouse password.
# .env is gitignored. Never commit real values.

# --- ClickHouse (local dev via docker compose) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=reel
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=subtext
CLICKHOUSE_SECURE=false

# --- Gemini ---
# Get a key at https://aistudio.google.com/apikey  (free tier is enough for this project).
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
SUBTEXT_MODEL=gemini-2.5-flash

# --- Embeddings (local, free) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
