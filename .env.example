# Copy to .env and fill in.  `make env` generates one with a random ClickHouse password.
# .env is gitignored. Never commit real values.

# --- ClickHouse ---
# The product runs against ClickHouse Cloud (GCP us-east1), which is where the Mexican
# corpus, the phrase index, the embeddings and the answer cache live. Its shape:
#   CLICKHOUSE_HOST=<your-service>.us-east1.gcp.clickhouse.cloud
#   CLICKHOUSE_HTTP_PORT=8443
#   CLICKHOUSE_NATIVE_PORT=9440
#   CLICKHOUSE_USER=default
#   CLICKHOUSE_SECURE=true
# The values below are for the local docker-compose instance instead (`make up`), which
# is enough to build the corpus yourself from `make fetch`.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=reel
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=subtext
CLICKHOUSE_SECURE=false

# --- Gemini ---
# Get a key at https://aistudio.google.com/api-keys — must be an AUTH key (bound to a service
# account). Standard keys are rejected by the Gemini API as of September 2026.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
SUBTEXT_MODEL=gemini-3.8-flash

# --- Embeddings (Gemini) ---
# 768 measured the same as 3072 on retrieval and stores a quarter as much. Vectors are
# normalised in code: Google requires it for any dimension below 3072.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Google Translate control (optional; the site shows it only when it works) ---
# Project to bill for Cloud Translation. On Cloud Run the service account needs roles/cloudtranslate.user.
GOOGLE_CLOUD_PROJECT=
